<Window x:Class="WpfDemoExam02.AdminAddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDemoExam02"
        mc:Ignorable="d"
        Icon="/Icon/icon.ico"
        FontFamily="Comic Sans MS"
        Title="Добавление продукта" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" x:Name="backBtn" Content="Назад" Width="120" HorizontalAlignment="Left" Click="backBtn_Click" Background="#546F94"/>
        <Label Grid.Row="0" Grid.ColumnSpan="4" x:Name="userInfoLb" HorizontalAlignment="Right"/>

        <Image Grid.Column="0" Grid.Row="1" x:Name="previewImg" Width="220" Height="320"/>

        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#ABCFCE">
                <TextBlock Text="Картинка:"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Путь до файла:"/>
                    <TextBox x:Name="filePathTb" Width="200" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                    <Button x:Name="selectFileBtn" Content="Выбрать файл" Margin="0,0,5,0" Click="selectFileBtn_Click" Background="#546F94"/>
                    <Button x:Name="removeFileBtn" Content="Убрать" Click="removeFileBtn_Click" Background="#546F94"/>
                </StackPanel>

                <TextBlock Text="Название товара:"/>
                <TextBox x:Name="nameTb" Width="200" HorizontalAlignment="Left"/>

                <TextBlock Text="Категория:"/>
                <ComboBox x:Name="categoryCb" Width="200" HorizontalAlignment="Left" DisplayMemberPath="Name"/>

                <TextBlock Text="Описание товара:"/>
                <TextBox x:Name="descriptionTb" Width="400" HorizontalAlignment="Left" VerticalAlignment="Stretch" TextWrapping="Wrap"/>

                <TextBlock Text="Производитель:"/>
                <ComboBox x:Name="manufacturerCb" Width="200" HorizontalAlignment="Left" DisplayMemberPath="Name"/>

                <TextBlock Text="Поставщик:"/>
                <ComboBox x:Name="supplierCb" Width="200" HorizontalAlignment="Left" DisplayMemberPath="Name"/>

                <TextBlock Text="Цена:"/>
                <TextBox x:Name="priceTb" Width="200" HorizontalAlignment="Left" PreviewTextInput="priceTb_PreviewTextInput"/>

                <TextBlock Text="Единица измерения:"/>
                <ComboBox x:Name="unitCb" Width="200" HorizontalAlignment="Left" DisplayMemberPath="Name"/>

                <TextBlock Text="Количество на складе:"/>
                <TextBox x:Name="amountTb" Width="200" HorizontalAlignment="Left" PreviewTextInput="amountTb_PreviewTextInput"/>

                <TextBlock Text="Скидка:"/>
                <TextBox x:Name="discountTb" Width="200" HorizontalAlignment="Left" PreviewTextInput="discountTb_PreviewTextInput"/>

                <Button x:Name="addProductBtn" Content="Добавить товар" Width="250" Margin="0,5" Click="addProductBtn_Click" Background="#546F94"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
