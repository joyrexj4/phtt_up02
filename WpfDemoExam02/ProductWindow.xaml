<Window x:Class="WpfDemoExam02.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDemoExam02"
        mc:Ignorable="d"
        Icon="/Icon/icon.ico"
        FontFamily="Comic Sans MS"
        Title="Окно товара" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" x:Name="backBtn" Content="Назад" Width="120" HorizontalAlignment="Left" Click="backBtn_Click" Background="#546F94"/>
        <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" x:Name="userInfoLb" HorizontalAlignment="Right"/>

        <Image Grid.Column="0" Grid.Row="1" x:Name="img" Width="200" Height="280"/>

        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock x:Name="productNameTb" Text="Товар" TextWrapping="WrapWithOverflow" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="productCategoryTb" Text="Категория: "/>
            <TextBlock x:Name="productDescriptionTb" Text="Описание: "/>
            <TextBlock x:Name="productManufacturerTb" Text="Производитель: "/>
            <TextBlock x:Name="productSupplierTb" Text="Поставщик: "/>
            <TextBlock x:Name="productPriceTb" Text="Цена: "/>
            <TextBlock x:Name="productDiscountTb" Text="Скидка: "/>
            <TextBlock x:Name="productDiscountPriceTb" Text="Цена со скидкой: "/>
            <TextBlock x:Name="productUnitTb" Text="Единица измерения: "/>
            <TextBlock x:Name="productAmountTb" Text="Количество на складе: "/>

            <TextBlock Text="Выберите количество:" Margin="0,20,0,0"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="decreaseBtn" Content="-" Width="25" Click="decreaseBtn_Click" Background="#ABCFCE"/>
                <TextBox x:Name="amountTb" Text="1" Width="60" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" PreviewTextInput="amountTb_PreviewTextInput" LostFocus="amountTb_LostFocus"/>
                <Button x:Name="increaseBtn" Content="+" Width="25" Click="increaseBtn_Click" Background="#ABCFCE"/>

            </StackPanel>
                <Label x:Name="totalPriceLb" Content="Итого:" FontWeight="Bold"/>
            <Button x:Name="addToCartBtn" Content="Добавить в корзину" Width="200" Margin="0,20,0,0" Click="addToCartBtn_Click" Visibility="Hidden" Background="#546F94"/>
        </StackPanel>
    </Grid>
</Window>
