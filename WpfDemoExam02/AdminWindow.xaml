<Window x:Class="WpfDemoExam02.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDemoExam02"
        mc:Ignorable="d"
        Icon="/Icon/icon.ico"
        FontFamily="Comic Sans MS"
        Title="Окно администратора" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Grid.Row="0" x:Name="logoutBtn" Content="Выйти" Width="120" HorizontalAlignment="Left" Click="logoutBtn_Click" Background="#546F94"/>
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" x:Name="userInfoLb" Content="Администратор" HorizontalAlignment="Right"/>

        <DataGrid Grid.Column="0" Grid.Row="1" x:Name="productsDg" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Product.Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Width="150" Background="#ABCFCE">
            <Label Content="Товары" HorizontalAlignment="Center" FontWeight="Bold" FontSize="24"/>
            <Button x:Name="viewProductsBtn" Content="Посмотреть товары" Click="viewProductsBtn_Click" Background="#546F94"/>
            <Button x:Name="addProductBtn" Content="Добавить товар" Margin="0,10,0,10" Click="addProductBtn_Click" Background="#546F94"/>
            <Button x:Name="editProductBtn" Content="Редактировать товар" Margin="0,0,0,10" Click="editProductBtn_Click" Background="#546F94"/>
            <Button x:Name="deleteProductBtn" Content="Удалить товар" Click="deleteProductBtn_Click" Background="#546F94"/>
        </StackPanel>

        <DataGrid Grid.Column="3" Grid.Row="1" x:Name="usersDg" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" Width="150" Background="#ABCFCE">
            <Label Content="Заказы" HorizontalAlignment="Center" FontWeight="Bold" FontSize="24"/>
            <Button x:Name="viewOrdersBtn" Content="Посмотреть заказы" Click="viewOrdersBtn_Click" Background="#546F94"/>
            <Button x:Name="addOrderBtn" Content="Добавить заказ" Margin="0,10,0,10" Click="addOrderBtn_Click" Background="#546F94"/>
            <Button x:Name="editOrderBtn" Content="Редактировать заказ" Margin="0,0,0,10" Click="editOrderBtn_Click" Background="#546F94"/>
            <Button x:Name="deleteOrderBtn" Content="Удалить заказ" Click="deleteOrderBtn_Click" Background="#546F94"/>
        </StackPanel>
    </Grid>
</Window>
