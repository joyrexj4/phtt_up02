<Window x:Class="WpfDemoExam02.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDemoExam02"
        mc:Ignorable="d"
        Icon="/Icon/icon.ico"
        FontFamily="Comic Sans MS"
        Title="Окно авторизации" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Авторизация" FontWeight="Bold" FontSize="26"/>
            
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="loginTb"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="passwordPb"/>

            <Button x:Name="SignInBtn" Content="Войти" Margin="0,10" Click="SignInBtn_Click" Background="#546F94"/>
            <Button x:Name="GuestModeBtn" Content="Зайти как гость" Click="GuestModeBtn_Click" Background="#546F94"/>
        </StackPanel>
    </Grid>
</Window>
